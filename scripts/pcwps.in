#!/data/data/com.termux/files/usr/bin/bash
#
# pcwps — start (or stop) desktop WPS Office on Android.
# Generated from scripts/pcwps.in by install.sh.
#
#   pcwps            the container's default — on a slim build, WPS Writer alone
#   pcwps writer     WPS Writer
#   pcwps et         WPS Spreadsheets
#   pcwps wpp        WPS Presentation
#   pcwps pdf        WPS PDF
#   pcwps desktop    full XFCE desktop (only on a PROFILE=desktop container)
#   pcwps stop       shut everything down
#
# Flags:
#   --no-window      start everything but leave the Termux:X11 window closed.
#                    WPS runs in the background; open the Termux:X11 app when
#                    you want it. This is what the boot hook uses by default.
#   --quiet          suppress progress output (the boot hook logs to a file)
#
set -u

DISTRO="@DISTRO@"

NO_WINDOW=0
QUIET=0
MODE=default

for arg in "$@"; do
  case "$arg" in
    --no-window) NO_WINDOW=1 ;;
    --quiet)     QUIET=1 ;;
    -h|--help)   sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --*)         echo "pcwps: unknown flag '$arg'" >&2; exit 2 ;;
    *)           MODE="$arg" ;;
  esac
done

log()  { [ "$QUIET" = 1 ] || printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }

stop_all() {
  log "Stopping session"
  pkill -f "start-wps-session"  2>/dev/null
  pkill -f "xfce4-session"      2>/dev/null
  pkill -f "matchbox-window-ma" 2>/dev/null
  pkill -f "termux.x11"         2>/dev/null
  pkill -f "com.termux.x11"     2>/dev/null
  pulseaudio --kill             2>/dev/null
  am force-stop com.termux.x11  2>/dev/null
  termux-wake-unlock            2>/dev/null
  log "Stopped"
}

if [ "$MODE" = stop ]; then stop_all; exit 0; fi

case "$MODE" in
  default|desktop|writer|wps|et|wpp|pdf) ;;
  *) echo "usage: pcwps [writer|et|wpp|pdf|desktop|stop] [--no-window] [--quiet]" >&2; exit 2 ;;
esac

if ! pm list packages 2>/dev/null | grep -q 'com\.termux\.x11'; then
  warn "The Termux:X11 companion app is not installed."
  warn "Get the arm64 APK from https://github.com/termux/termux-x11/releases,"
  warn "install it, then run pcwps again."
  exit 1
fi

# A stale server from a previous run will make the new one bind-fail silently.
pkill -f "termux.x11" 2>/dev/null
sleep 1

log "Starting audio server"
pulseaudio --start --exit-idle-time=-1 \
  --load="module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-anonymous=1" \
  >/dev/null 2>&1 || warn "pulseaudio did not start; the session will be silent"

log "Starting X server"
XDG_RUNTIME_DIR="${TMPDIR:-/data/data/com.termux/files/usr/tmp}" \
  termux-x11 :0 >/dev/null 2>&1 &
X11_PID=$!

# Wait for the server to actually listen rather than guessing with a fixed sleep.
for _ in $(seq 1 20); do
  [ -e "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/.X11-unix/X0" ] && break
  kill -0 "$X11_PID" 2>/dev/null || { warn "termux-x11 exited immediately"; exit 1; }
  sleep 0.5
done

if [ "$NO_WINDOW" = 1 ]; then
  log "Leaving the Termux:X11 window closed (--no-window)"
else
  log "Opening the Termux:X11 window"
  am start -n com.termux.x11/.MainActivity >/dev/null 2>&1
  sleep 1
fi

log "Launching WPS ($MODE)"
proot-distro login "$DISTRO" --shared-tmp -- \
  /bin/bash -lc "DISPLAY=:0 PULSE_SERVER=tcp:127.0.0.1 /usr/local/bin/start-wps-session '$MODE'"

log "Session ended"
stop_all
