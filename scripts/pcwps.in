#!/data/data/com.termux/files/usr/bin/bash
#
# pcwps — start (or stop) desktop WPS Office on Android.
# Generated from scripts/pcwps.in by install.sh.
#
#   pcwps            the container's default — on a slim build, WPS Writer alone
#   pcwps writer     WPS Writer
#   pcwps et         WPS Spreadsheets
#   pcwps wpp        WPS Presentation
#   pcwps pdf        WPS PDF
#   pcwps desktop    full XFCE desktop (only on a PROFILE=desktop container)
#   pcwps show       bring an already-running session to the front
#   pcwps stop       shut everything down
#
# Tapping a launcher icon while a session is already up does not restart it:
# the window is brought forward, and a different app is opened alongside the
# one already running rather than replacing it.
#
# Flags:
#   --no-window      start everything but leave the Termux:X11 window closed.
#                    WPS runs in the background; open the Termux:X11 app when
#                    you want it. This is what the boot hook uses by default.
#   --quiet          suppress progress output (the boot hook logs to a file)
#
# Set PCWPS_DEBUG=1 to print the exact proot-distro command before running it.
#
set -u

DISTRO="@DISTRO@"

NO_WINDOW=0
QUIET=0
MODE=default

for arg in "$@"; do
  case "$arg" in
    --no-window) NO_WINDOW=1 ;;
    --quiet)     QUIET=1 ;;
    -h|--help)   sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --*)         echo "pcwps: unknown flag '$arg'" >&2; exit 2 ;;
    *)           MODE="$arg" ;;
  esac
done

log()  { [ "$QUIET" = 1 ] || printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }

stop_all() {
  log "Stopping session"
  pkill -f "start-wps-session"  2>/dev/null
  pkill -f "xfce4-session"      2>/dev/null
  pkill -f "matchbox-window-ma" 2>/dev/null
  pkill -f "termux.x11"         2>/dev/null
  pkill -f "com.termux.x11"     2>/dev/null
  pulseaudio --kill             2>/dev/null
  am force-stop com.termux.x11  2>/dev/null
  termux-wake-unlock            2>/dev/null
  log "Stopped"
}

if [ "$MODE" = stop ]; then stop_all; exit 0; fi

case "$MODE" in
  default|desktop|writer|wps|et|wpp|pdf|show) ;;
  *) echo "usage: pcwps [writer|et|wpp|pdf|desktop|show|stop] [--no-window] [--quiet]" >&2; exit 2 ;;
esac

XSOCK_DIR="${TMPDIR:-/data/data/com.termux/files/usr/tmp}/.X11-unix"
XSOCK="$XSOCK_DIR/X0"

# Android's package-visibility rules mean `pm list packages` run from Termux
# often cannot see Termux:X11 even when it is installed, so presence is never
# tested up front -- the window is simply opened, and only a real failure to
# start the activity is reported. A false negative here used to abort the
# whole launch.
show_window() {
  [ "$NO_WINDOW" = 1 ] && return 0
  local out
  out="$(am start -n com.termux.x11/.MainActivity 2>&1)" || true
  if printf '%s' "$out" | grep -qiE 'error|does not exist|not found'; then
    warn "Could not open the Termux:X11 window automatically."
    warn "Open the Termux:X11 app yourself — WPS is running and will appear there."
    warn "Not installed? https://github.com/termux/termux-x11/releases"
    return 1
  fi
  return 0
}

# Run an app inside the container. start-wps-session only starts a window
# manager if one is not already running, so this is safe to call against a
# session that is already up.
#
# The container needs to reach the X server's socket, which lives in Termux's
# tmp. `--shared-tmp` is the obvious way to arrange that, but some
# proot-distro/proot combinations mishandle it and proot bails with
# `expected absolute path: "--shm-helper"`, so bind exactly the one directory
# that matters instead. This is the same --bind form the installer uses.
run_app() {
  local args=("$DISTRO")

  # Only bind the socket directory if it actually exists. proot rejects a
  # missing or non-absolute bind source, and the failure is opaque.
  if [ -d "$XSOCK_DIR" ]; then
    args+=(--bind "$XSOCK_DIR:/tmp/.X11-unix")
  else
    warn "no X socket directory at $XSOCK_DIR — continuing without binding it"
  fi

  args+=(-- /bin/bash -lc \
    "DISPLAY=:0 PULSE_SERVER=tcp:127.0.0.1 /usr/local/bin/start-wps-session '$1'")

  if [ "${PCWPS_DEBUG:-0}" = 1 ]; then
    printf '\033[1;35mdebug:\033[0m TMPDIR=[%s]\n' "${TMPDIR:-}"
    printf '\033[1;35mdebug:\033[0m XSOCK_DIR=[%s] exists=%s\n' \
      "$XSOCK_DIR" "$([ -d "$XSOCK_DIR" ] && echo yes || echo no)"
    printf '\033[1;35mdebug:\033[0m proot-distro login'
    printf ' [%s]' "${args[@]}"
    printf '\n'
    ls -la "$XSOCK_DIR" 2>&1 | sed 's/^/debug:   /'
  fi

  proot-distro login "${args[@]}"
}

# Already running? Then a tap on a launcher icon should surface it, not tear
# the whole session down and rebuild it.
if [ -e "$XSOCK" ] && pgrep -f "termux.x11" >/dev/null 2>&1; then
  log "Session already running"
  show_window || true
  case "$MODE" in
    show|default|desktop) exit 0 ;;
    *) log "Opening $MODE in the running session"; run_app "$MODE"; exit 0 ;;
  esac
fi

if [ "$MODE" = show ]; then
  warn "No session is running. Start one with: pcwps [writer|et|wpp|pdf]"
  exit 1
fi

# A stale server from a previous run will make the new one bind-fail silently.
pkill -f "termux.x11" 2>/dev/null
sleep 1

log "Starting audio server"
pulseaudio --start --exit-idle-time=-1 \
  --load="module-native-protocol-tcp auth-ip-acl=127.0.0.1 auth-anonymous=1" \
  >/dev/null 2>&1 || warn "pulseaudio did not start; the session will be silent"

mkdir -p "$XSOCK_DIR" 2>/dev/null || true

log "Starting X server"
XDG_RUNTIME_DIR="${TMPDIR:-/data/data/com.termux/files/usr/tmp}" \
  termux-x11 :0 >/dev/null 2>&1 &
X11_PID=$!

# Wait for the server to actually listen rather than guessing with a fixed sleep.
for _ in $(seq 1 20); do
  [ -e "$XSOCK" ] && break
  kill -0 "$X11_PID" 2>/dev/null || { warn "termux-x11 exited immediately"; exit 1; }
  sleep 0.5
done

if [ "$NO_WINDOW" = 1 ]; then
  log "Leaving the Termux:X11 window closed (--no-window)"
else
  log "Opening the Termux:X11 window"
  show_window || true
  sleep 1
fi

log "Launching WPS ($MODE)"
run_app "$MODE"

log "Session ended"
stop_all
